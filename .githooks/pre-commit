#!/bin/sh

NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh" --no-use
  nvm use --silent 24 || exit 2
fi

if ! command -v fnr-guard >/dev/null 2>&1; then
  echo "fnr-guard is required to commit. Install it and ensure it is on PATH." >&2
  exit 2
fi

exec fnr-guard scan --staged
